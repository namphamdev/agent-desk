# ── Core ──────────────────────────────────────────────
DATA_DIR=./data
PORT=3000

# ── Auth ──────────────────────────────────────────────
# "dev" = bearer token IS the userId (never use in production).
# "workos" = verify WorkOS AuthKit JWTs.
AUTH_MODE=dev
WORKOS_CLIENT_ID=
# Optional overrides (defaults are derived from WORKOS_CLIENT_ID):
# WORKOS_ISSUER=https://api.workos.com/user_management/<client_id>
# WORKOS_JWKS_URL=https://api.workos.com/sso/jwks/<client_id>
WORKOS_API_KEY=

# ── Account settings encryption ───────────────────────
# Base64-encoded 32-byte AES-256-GCM key. Generate with:
#   openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=

# ── Push notifications ────────────────────────────────
# Shared secret the Rust engine sends to /push/send.
PUSH_INTERNAL_SECRET=
